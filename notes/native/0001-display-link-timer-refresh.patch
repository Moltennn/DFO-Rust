 #if USE(LIBDRM)
 #include "DisplayVBlankMonitorDRM.h"
 #endif
@@ -67,6 +72,16 @@
     RELEASE_LOG_FAULT(DisplayLink, "Failed to create DRM vblank monitor, falling back to timer");
 #endif
 
+#if PLATFORM(GTK)
+    // The DRM vblank monitor is unavailable to a Wayland client that is not
+    // the DRM master; the 60 Hz timer fallback then caps the display link at
+    // 60 even on a 144 Hz output. Use the monitor's own refresh rate instead.
+    if (auto* monitor = ScreenManager::singleton().screen(displayID)) {
+        if (auto refreshRate = gdk_monitor_get_refresh_rate(monitor))
+            return DisplayVBlankMonitorTimer::create(refreshRate / 1000);
+    }
+#endif
+
     return DisplayVBlankMonitorTimer::create();
 }
